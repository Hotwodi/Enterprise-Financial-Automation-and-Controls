<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_efa_reconciliation_rule_tree" model="ir.ui.view">
        <field name="name">efa.reconciliation.rule.tree</field>
        <field name="model">efa.reconciliation.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="tolerance"/>
                <field name="auto_match" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="matched_count"/>
                <field name="unmatched_count"/>
                <field name="last_run"/>
            </tree>
        </field>
    </record>

    <record id="view_efa_reconciliation_rule_form" model="ir.ui.view">
        <field name="name">efa.reconciliation.rule.form</field>
        <field name="model">efa.reconciliation.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_reconciliation" type="object" string="Run Now" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rule_type"/>
                            <field name="tolerance" invisible="rule_type not in ('fuzzy_match', 'composite')"/>
                            <field name="auto_match"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="matched_count"/>
                            <field name="unmatched_count"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_efa_reconciliation_rule" model="ir.actions.act_window">
        <field name="name">Reconciliation Rules</field>
        <field name="res_model">efa.reconciliation.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
